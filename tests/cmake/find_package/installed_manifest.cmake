# Inspect only the relocated install, never source/build-tree metadata.
if(NOT DEFINED SDK_INSTALL_PREFIX OR SDK_INSTALL_PREFIX STREQUAL "")
  message(FATAL_ERROR "SDK_INSTALL_PREFIX is required")
endif()
foreach(feature EXPECTED_REALTIME EXPECTED_COREAUDIO EXPECTED_WASAPI EXPECTED_SHMUI EXPECTED_SHMUI_GL)
  if(NOT DEFINED ${feature})
    message(FATAL_ERROR "Missing exported feature expectation: ${feature}")
  endif()
endforeach()

set(required_names core diagnostics audio_utils audio_io audio_driver_manager routing transport)
set(platform_names audio_driver_coreaudio audio_driver_wasapi)
set(optional_names shmui_juce shmui_juce_gl)

function(check_manifest brand namespace)
  file(READ "${SDK_INSTALL_PREFIX}/share/${brand}/installed-targets.json" manifest)
  string(JSON schema GET "${manifest}" schemaVersion)
  string(JSON version GET "${manifest}" sdkVersion)
  if(NOT schema EQUAL 1 OR NOT version VERSION_EQUAL ORPHEUS_REQUIRED_VERSION)
    message(FATAL_ERROR "${brand} manifest schema/version mismatch")
  endif()
  set(all_names)
  foreach(category required platformConditional optional)
    string(JSON count LENGTH "${manifest}" ${category})
    set(category_names)
    if(count GREATER 0)
      math(EXPR last "${count} - 1")
      foreach(index RANGE 0 ${last})
        string(JSON target GET "${manifest}" ${category} ${index} target)
        if(NOT target MATCHES "^${namespace}::[a-z_]+$")
          message(FATAL_ERROR "Invalid ${brand} manifest target: ${target}")
        endif()
        string(REPLACE "${namespace}::" "" name "${target}")
        if(name IN_LIST all_names)
          message(FATAL_ERROR "Duplicate ${brand} manifest target: ${target}")
        endif()
        list(APPEND all_names "${name}")
        list(APPEND category_names "${name}")
        set(enabled ON)
        if(category STREQUAL "required" AND
           name MATCHES "^(audio_utils|audio_io|audio_driver_manager|routing|transport)$")
          set(enabled "${EXPECTED_REALTIME}")
        endif()
        if(category STREQUAL "platformConditional")
          string(JSON platform GET "${manifest}" ${category} ${index} platform)
          if(name STREQUAL "audio_driver_coreaudio" AND platform STREQUAL "macOS")
            set(enabled "${EXPECTED_COREAUDIO}")
            if(enabled AND NOT APPLE)
              message(FATAL_ERROR "CoreAudio export expected on a non-Apple platform")
            endif()
          elseif(name STREQUAL "audio_driver_wasapi" AND platform STREQUAL "Windows")
            set(enabled "${EXPECTED_WASAPI}")
            if(enabled AND NOT WIN32)
              message(FATAL_ERROR "WASAPI export expected on a non-Windows platform")
            endif()
          else()
            message(FATAL_ERROR "Unknown manifest platform contract: ${target} / ${platform}")
          endif()
        elseif(category STREQUAL "optional")
          string(JSON feature GET "${manifest}" ${category} ${index} feature)
          if(name STREQUAL "shmui_juce" AND feature STREQUAL "ORPHEUS_ENABLE_SHMUI_JUCE")
            set(enabled "${EXPECTED_SHMUI}")
          elseif(name STREQUAL "shmui_juce_gl" AND feature STREQUAL "SHMUI_JUCE_ENABLE_OPENGL")
            set(enabled "${EXPECTED_SHMUI_GL}")
          else()
            message(FATAL_ERROR "Unknown manifest feature contract: ${target} / ${feature}")
          endif()
          if(enabled)
            string(JSON dependency_count LENGTH "${manifest}" ${category} ${index} requires)
            if(dependency_count EQUAL 0)
              message(FATAL_ERROR "Optional target ${target} has no declared dependencies")
            endif()
            math(EXPR last_dependency "${dependency_count} - 1")
            foreach(dependency_index RANGE 0 ${last_dependency})
              string(JSON dependency GET "${manifest}" ${category} ${index} requires ${dependency_index})
              if(NOT TARGET "${dependency}")
                message(FATAL_ERROR "${target} is missing declared dependency ${dependency}")
              endif()
            endforeach()
          endif()
        endif()

        set(native "Orpheus::orpheus_${name}")
        foreach(facade "Orpheus::${name}" "Treefall::${name}")
          if(enabled)
            if(NOT TARGET "${facade}" OR NOT TARGET "${native}")
              message(FATAL_ERROR "Enabled manifest target ${facade} lacks its exported binary ${native}")
            endif()
            get_target_property(backing "${facade}" INTERFACE_LINK_LIBRARIES)
            if(NOT backing STREQUAL native)
              message(FATAL_ERROR "${facade} does not share the physical target ${native}: ${backing}")
            endif()
          elseif(TARGET "${facade}" OR TARGET "${native}")
            message(FATAL_ERROR "Disabled feature unexpectedly exports ${facade} or ${native}")
          endif()
        endforeach()
        if(enabled)
          get_target_property(imported "${native}" IMPORTED)
          if(NOT imported)
            message(FATAL_ERROR "${native} is not an installed imported target")
          endif()
          get_target_property(native_type "${native}" TYPE)
          set(found_artifact OFF)
          get_target_property(configurations "${native}" IMPORTED_CONFIGURATIONS)
          foreach(configuration IN LISTS configurations)
            string(TOUPPER "${configuration}" configuration)
            foreach(property IMPORTED_LOCATION IMPORTED_IMPLIB)
              get_target_property(location "${native}" "${property}_${configuration}")
              if(location AND NOT location MATCHES "-NOTFOUND$")
                set(found_artifact ON)
                cmake_path(IS_PREFIX SDK_INSTALL_PREFIX "${location}" NORMALIZE inside_prefix)
                if(NOT inside_prefix OR NOT EXISTS "${location}")
                  message(FATAL_ERROR "${native} artifact is not in the clean prefix: ${location}")
                endif()
              endif()
            endforeach()
          endforeach()
          if(NOT native_type STREQUAL "INTERFACE_LIBRARY" AND NOT found_artifact)
            message(FATAL_ERROR "${native} has no installed physical artifact")
          endif()
        endif()
      endforeach()
    endif()
    if(category STREQUAL "required")
      set(expected_names "${required_names}")
    elseif(category STREQUAL "platformConditional")
      set(expected_names "${platform_names}")
    else()
      set(expected_names "${optional_names}")
    endif()
    list(SORT category_names)
    list(SORT expected_names)
    if(NOT category_names STREQUAL expected_names)
      message(FATAL_ERROR "Incomplete ${brand} ${category} manifest: ${category_names}; expected ${expected_names}")
    endif()
  endforeach()
  # Compare every metadata member too, not merely the target names.
  string(REPLACE "${namespace}::" "SDK::" normalized "${manifest}")
  set(${brand}_manifest_normalized "${normalized}" PARENT_SCOPE)
endfunction()

check_manifest(orpheus Orpheus)
check_manifest(treefall Treefall)
if(NOT orpheus_manifest_normalized STREQUAL treefall_manifest_normalized)
  message(FATAL_ERROR "Orpheus and Treefall installed manifests differ beyond their namespaces")
endif()
foreach(asio_target Orpheus::audio_driver_asio Treefall::audio_driver_asio Orpheus::orpheus_audio_driver_asio)
  if(TARGET "${asio_target}")
    message(FATAL_ERROR "Source-only ASIO target leaked into the installed package: ${asio_target}")
  endif()
endforeach()
file(GLOB_RECURSE private_session_headers "${SDK_INSTALL_PREFIX}/include/*json_io.h")
if(private_session_headers)
  message(FATAL_ERROR "Private session header leaked into the installed package: ${private_session_headers}")
endif()
# Internal ABI runtime, ABI facade libraries, sanitizers and source-only host
# executables are not advertised manifest scenarios and are intentionally not
# added to the public required list.

# Inventory the installed export in both directions: a new public binary must
# not silently escape manifest coverage. These are implementation/support
# exports rather than manifest scenarios.
get_property(installed_imports DIRECTORY PROPERTY IMPORTED_TARGETS)
set(non_manifest_exports abi_runtime session clipgrid render sanitizers)
set(non_manifest_executables minhost perf_render_click)
set(manifest_names ${required_names} ${platform_names} ${optional_names})
foreach(imported_target IN LISTS installed_imports)
  if(imported_target MATCHES "^Orpheus::orpheus_(.+)$")
    set(name "${CMAKE_MATCH_1}")
    if(name IN_LIST non_manifest_executables)
      get_target_property(export_kind "${imported_target}" TYPE)
      if(NOT export_kind STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "Source/tool artifact is not an executable: ${imported_target}")
      endif()
    elseif(NOT name IN_LIST manifest_names AND NOT name IN_LIST non_manifest_exports)
      message(FATAL_ERROR "Installed export lacks manifest coverage: ${imported_target}")
    endif()
  endif()
endforeach()
